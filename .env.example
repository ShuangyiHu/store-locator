# --- Application ---
APP_NAME=Store Locator API
DEBUG=false
ENVIRONMENT=development

# --- Database ---
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/store_locator

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace-me-with-a-long-random-string-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Geocoding (Nominatim) ---
# REQUIRED: Nominatim policy mandates a unique User-Agent identifying your app + contact
NOMINATIM_USER_AGENT=store-locator/1.0 (your-email@example.com)
GEOCODING_CACHE_TTL_SECONDS=2592000

# --- Rate limiting (per IP, public endpoints) ---
RATE_LIMIT_PER_HOUR=100
RATE_LIMIT_PER_MINUTE=10

# --- Search ---
SEARCH_CACHE_TTL_SECONDS=300
DEFAULT_RADIUS_MILES=10
MAX_RADIUS_MILES=100

# --- CORS (JSON array) ---
CORS_ORIGINS=["*"]
